// Ubuntu 24.04 + GCC 14 variant of the MARTY dev container.
// The default devcontainer (../devcontainer.json) uses Ubuntu 22.04 + GCC 11.
// For format details, see https://aka.ms/devcontainer.json.

{
	"name": "marty-dev-gcc14",

	// Builds the image from the Dockerfile in this folder.
	"build": {
		"dockerfile": "Dockerfile"
	},

	// Custom arguments to pass to the container manager when creating the container from the image.
	// With Podman, add "--userns=keep-id" here so the container can write into the host filesystem.
	"runArgs": [
	],

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools-themes",
				"ms-vscode.cpptools",
				"twxs.cmake",
				"ms-vscode.cmake-tools",
				"ms-vscode.cpptools-extension-pack",
				"ms-vscode.makefile-tools",
				"mhutchie.git-graph",
				"ms-azuretools.vscode-docker",
				"cschlosser.doxdocgen",
				"mintlify.document",
				"zeshuaro.vscode-python-poetry",
				"ms-python.python",
				"ms-toolsai.jupyter",
				"github.vscode-github-actions",
				"GitHub.copilot-chat",
				"GitHub.copilot"
			]
		}
	}

	// The container runs as root (no remoteUser/containerUser set), like the default one.
}
