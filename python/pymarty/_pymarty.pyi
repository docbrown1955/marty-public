import enum
from collections.abc import Iterable, Mapping, Sequence
from typing import Any

__version__: str

class MartyError(Exception): ...
class MartyValueError(MartyError, ValueError): ...
class MartyTypeError(MartyError, TypeError): ...
class MartyLookupError(MartyError, LookupError): ...
class MartyNotImplementedError(MartyError, NotImplementedError): ...
class MartyStateError(MartyError, RuntimeError): ...
class MartyBuildError(MartyError, RuntimeError): ...
class MartyZeroDivisionError(MartyError, ZeroDivisionError): ...

class ComplexProperty(enum.Enum):
    Complex = 0
    Real = 1
    Imaginary = 2

class Expr:
    def __init__(self, value: object) -> None: ...
    def __add__(self, other: object) -> Expr: ...
    def __radd__(self, other: object) -> Expr: ...
    def __sub__(self, other: object) -> Expr: ...
    def __rsub__(self, other: object) -> Expr: ...
    def __mul__(self, other: object) -> Expr: ...
    def __rmul__(self, other: object) -> Expr: ...
    def __truediv__(self, other: object) -> Expr: ...
    def __rtruediv__(self, other: object) -> Expr: ...
    def __pow__(self, other: object) -> Expr: ...
    def __rpow__(self, other: object) -> Expr: ...
    def __neg__(self) -> Expr: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def __call__(self, operand: object) -> Expr: ...
    def structural_key(self) -> tuple[Any, ...]: ...
    def expand(self) -> Expr: ...
    def factor(self, by: object | None = None, *, full: bool = False) -> Expr: ...
    def collect(self, factors: Iterable[object], *, full: bool = False) -> Expr: ...
    def diff(self, symbol: Expr) -> Expr: ...
    def replace(self, mapping: Mapping[object, object]) -> Expr: ...
    def evaluate(
        self,
        mapping: Mapping[object, object] | None = None,
        /,
        *,
        mode: EvalMode = ...,
        **by_name: object,
    ) -> Expr: ...
    def conjugate(self) -> Expr: ...
    def real_part(self) -> Expr: ...
    def imag_part(self) -> Expr: ...
    def depends_on(self, symbol: Expr) -> bool: ...
    @property
    def free_symbols(self) -> frozenset[Expr]: ...
    @property
    def name(self) -> str: ...
    @property
    def free_indices(self) -> tuple[Index, ...]: ...
    @property
    def dummy_indices(self) -> tuple[Index, ...]: ...
    def relabel_indices(
        self,
        renaming: dict[Index, Index] | None = None,
        *,
        relabel_free: bool = True,
    ) -> Expr: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...
    def to_latex(self) -> str: ...
    def _repr_latex_(self) -> str: ...
    def __complex__(self) -> complex: ...
    def __float__(self) -> float: ...
    def __int__(self) -> int: ...

I: Expr
infinity: Expr
pi: Expr
e: Expr

def constant(name: str, *, complex_property: ComplexProperty = ...) -> Expr: ...
def variable(name: str, *, complex_property: ComplexProperty = ...) -> Expr: ...
def make_abbreviation(name: str, expr: object) -> Expr: ...
def sqrt(e: object) -> Expr: ...
def exp(e: object) -> Expr: ...
def log(e: object) -> Expr: ...
def sin(e: object) -> Expr: ...
def cos(e: object) -> Expr: ...
def tan(e: object) -> Expr: ...
def asin(e: object) -> Expr: ...
def acos(e: object) -> Expr: ...
def atan(e: object) -> Expr: ...
def sinh(e: object) -> Expr: ...
def cosh(e: object) -> Expr: ...
def tanh(e: object) -> Expr: ...
def asinh(e: object) -> Expr: ...
def acosh(e: object) -> Expr: ...
def atanh(e: object) -> Expr: ...
def abs(e: object) -> Expr: ...
def modulus(e: object) -> Expr: ...
def argument(e: object) -> Expr: ...

class IndexType(enum.Enum):
    Free = 0
    Dummy = 1
    Fixed = 2

class EvalMode(enum.Enum):
    Base = 0
    Literal = 1
    Numerical = 2
    Indicial = 3
    Abbreviation = 4
    All = 15

    def __or__(self, other: EvalMode) -> EvalMode: ...
    def __and__(self, other: EvalMode) -> EvalMode: ...

class Index:
    @property
    def name(self) -> str: ...
    @property
    def space(self) -> Space | None: ...
    @property
    def type(self) -> IndexType: ...
    @property
    def id(self) -> int: ...
    @property
    def value(self) -> int: ...
    def flipped(self) -> Index: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class Space:
    def __init__(
        self, name: str, dimension: int, index_names: Sequence[str] = ...
    ) -> None: ...
    @property
    def dimension(self) -> int: ...
    def index(self, name: str | None = None) -> Index: ...
    def indices(self, n: int, name: str | None = None) -> tuple[Index, ...]: ...
    def fixed_index(self, value: int) -> Index: ...

class Tensor:
    def __call__(self, *indices: Index) -> Expr: ...

class TensorField:
    def __call__(self, *args: Index | Tensor) -> Expr: ...

class TensorDerivative:
    def __call__(self, index: Index, point: Tensor) -> Expr: ...

def tensor_field(
    name: str, point_space: Space, spaces: Sequence[Space] = ...
) -> TensorField: ...
def tensor_derivative(name: str, space: Space) -> TensorDerivative: ...

DEFAULT_INDEX_NAMES: tuple[str, ...]
Minkowski: Space
Euclid_R2: Space
Euclid_R3: Space
Euclid_R4: Space

def tensor(
    name: str,
    spaces: Sequence[Space],
    *,
    symmetric: object = False,
    antisymmetric: object = False,
    complex_property: ComplexProperty = ...,
) -> Tensor: ...
def delta(i: Index, j: Index) -> Expr: ...
def metric(i: Index, j: Index) -> Expr: ...
def epsilon(*indices: Index) -> Expr: ...

class Config:
    def __init__(
        self,
        include_path: str = "",
        library_path: str = "",
        cxx: str = "",
        make: str = "",
        grafed: str = "",
        package_data: str = "",
    ) -> None: ...
    @property
    def include_path(self) -> str: ...
    @property
    def library_path(self) -> str: ...
    @property
    def cxx(self) -> str: ...
    @property
    def make(self) -> str: ...
    @property
    def grafed(self) -> str: ...

class _debug:
    @staticmethod
    def raise_error(kind: str, message: str) -> None: ...
    @staticmethod
    def print_cout(text: str) -> None: ...
    @staticmethod
    def state_snapshot() -> dict[str, Any]: ...
    @staticmethod
    def restore_state(state: dict[str, Any]) -> None: ...
    @staticmethod
    def leak_state() -> None: ...
