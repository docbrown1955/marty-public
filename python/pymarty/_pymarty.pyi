class modeling:
    class GaugeGroup:
        def __init__(
            self,
            group: group_theory.Group,
            name: str,
            boson_name: str | None = None,
            coupling: str | None = None,
        ) -> None: ...
        @property
        def group(self) -> group_theory.Group: ...
        @property
        def name(self) -> str: ...
        @property
        def boson_name(self) -> str: ...
        @property
        def coupling(self) -> str: ...

    class FlavorGroup:
        def __init__(self, name: str, dim: int) -> None: ...
        @property
        def name(self) -> str: ...
        @property
        def dim(self) -> int: ...

    class Particle:
        @property
        def name(self) -> str: ...
        def set_rep(self, group: str, value: object) -> None: ...
        def expr(self) -> Expr: ...
        def __call__(self, *indices: Index) -> Expr: ...
        def field_strength(self) -> modeling.Particle: ...
        def similar(self, name: str) -> modeling.Particle: ...
        def set_self_conjugate(self, self_conjugate: bool) -> None: ...
        def set_fundamental_flavor_rep(self, flavor_group: str) -> None: ...
        def __repr__(self) -> str: ...

    class Order(enum.Enum):
        TreeLevel = ...
        OneLoop = ...

    class Leg:
        def __init__(
            self,
            field: modeling.Particle,
            incoming: bool,
            antiparticle: bool = False,
        ) -> None: ...
        @property
        def field(self) -> modeling.Particle: ...
        @property
        def incoming(self) -> bool: ...
        @property
        def antiparticle(self) -> bool: ...

    class Amplitude:
        @property
        def diagram_count(self) -> int: ...
        def __repr__(self) -> str: ...

    class FeynmanRules:
        def __len__(self) -> int: ...
        def __getitem__(self, index: int) -> str: ...
        def __iter__(self) -> Iterator[str]: ...
        def latex(self, index: int) -> str: ...
        def latex_document(self) -> str: ...
        def __repr__(self) -> str: ...

    class Model:
        def __init__(
            self,
            gauge: list[modeling.GaugeGroup],
            flavor: list[modeling.FlavorGroup] = ...,
        ) -> None: ...
        def weyl_fermion(
            self, name: str, chirality: str = "L"
        ) -> modeling.Particle: ...
        def dirac_fermion(self, name: str) -> modeling.Particle: ...
        def majorana_fermion(self, name: str) -> modeling.Particle: ...
        def scalar_boson(self, name: str) -> modeling.Particle: ...
        def add_particle(self, particle: modeling.Particle) -> None: ...
        def particle(self, name: str) -> modeling.Particle: ...
        def rename_particle(self, name: str, new_name: str) -> None: ...
        def __contains__(self, name: str) -> bool: ...
        @property
        def particles(self) -> list[modeling.Particle]: ...
        @property
        def feynman_rules(self) -> modeling.FeynmanRules: ...
        def refresh(self) -> None: ...
        def add_term(self, term: Expr, add_hermitic: bool = False) -> None: ...
        def replace(
            self,
            old: Expr | modeling.Particle,
            new: Expr | modeling.Particle,
        ) -> None: ...
        @overload
        def generate_index(self, group: str) -> Index: ...
        @overload
        def generate_index(self, group: str, field: str) -> Index: ...
        def promote_to_goldstone(self, goldstone: str, gauge_boson: str) -> None: ...
        def compute_amplitude(
            self, order: modeling.Order, legs: list[modeling.Leg]
        ) -> modeling.Amplitude: ...
        def compute_squared_amplitude(self, amplitude: modeling.Amplitude) -> Expr: ...
        def rotate_fields(
            self,
            fields: list[modeling.Particle],
            new_fields: list[modeling.Particle],
            rotation: list[list[Expr]],
            diagonalize_masses: bool = False,
            n_mass_less_fields: int = 0,
        ) -> None: ...
        def birotate_fields(
            self,
            fields1: list[modeling.Particle],
            fields2: list[modeling.Particle],
            n_mass_less_fields: int = 0,
        ) -> None: ...
        def add_bosonic_mass(self, field: modeling.Particle, mass: Expr) -> None: ...
        @overload
        def add_fermionic_mass(
            self, left: modeling.Particle, right: modeling.Particle, mass: Expr
        ) -> None: ...
        @overload
        def add_fermionic_mass(
            self, dirac_fermion: modeling.Particle, mass: Expr
        ) -> None: ...
        def coupling(self, name: str) -> Expr: ...
        def new_coupling(self, name: str) -> Expr: ...
        def break_gauge_symmetry(
            self, group: str, renaming: object = "default"
        ) -> None: ...
        def __str__(self) -> str: ...
        def __repr__(self) -> str: ...

    @staticmethod
    def standard_model() -> modeling.Model: ...
    @staticmethod
    def qed() -> modeling.Model: ...
    @staticmethod
    def dirac_index(name: str = "") -> Index: ...
    @staticmethod
    def renamed_indices(expr: Expr) -> Expr: ...

