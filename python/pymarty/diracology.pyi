from collections.abc import Iterable
from typing import NamedTuple

from pymarty._pymarty import diracology as _core

DiracExpr = _core.DiracExpr
FierzBasis = _core.FierzBasis

D: DiracExpr
I: DiracExpr

class FierzResult(NamedTuple):
    rhs: DiracExpr
    lhs: DiracExpr

def g(mu: int, nu: int) -> DiracExpr: ...
def eps(a: int, b: int, c: int, d: int) -> DiracExpr: ...
def gamma(mu: int, nu: int | None = None) -> DiracExpr: ...
def gamma5() -> DiracExpr: ...
def P_L() -> DiracExpr: ...
def P_R() -> DiracExpr: ...
def C() -> DiracExpr: ...
def current(chain: Iterable[DiracExpr], i_left: int, i_right: int) -> DiracExpr: ...
def trace(chain: Iterable[DiracExpr]) -> DiracExpr: ...
def single_fierz(
    chain1: DiracExpr, chain2: DiracExpr, basis: FierzBasis = ...
) -> FierzResult: ...
def double_fierz(
    chain1: DiracExpr, chain2: DiracExpr, basis: FierzBasis = ...
) -> FierzResult: ...
def symbolic_dimension(*, keep: bool) -> _core.SymbolicDimension: ...
def epsilon_index_ordering(*, order: bool) -> _core.EpsilonIndexOrdering: ...
def set_symbolic_dimension(*, keep_symbolic: bool) -> None: ...
